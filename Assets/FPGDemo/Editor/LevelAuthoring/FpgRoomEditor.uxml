<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="FpgRoomEditor.uss" />
    <ui:VisualElement name="room-editor-root" class="room-editor">
        <uie:Toolbar class="top-toolbar">
            <ui:Label text="FPG 房间编辑器" class="window-title" />
            <ui:VisualElement class="toolbar-spacer" />
            <uie:ToolbarButton name="create-room-button" text="新建" tooltip="创建房间资产" />
            <uie:ToolbarButton name="duplicate-room-button" text="复制" tooltip="复制房间并生成新房间 ID" />
            <uie:ToolbarButton name="save-room-button" text="保存关卡" tooltip="保存 RoomDefinition 与当前关卡美术场景" />
            <uie:ToolbarButton name="frame-room-button" text="聚焦" tooltip="在 SceneView 中聚焦所选标记或房间" />
        </uie:Toolbar>
        <ui:VisualElement class="camera-preview-toolbar">
            <ui:Label text="&#x6B63;&#x5F0F;&#x955C;&#x5934;" class="toolbar-label" />
            <uie:ObjectField name="camera-template-field" label="&#x6A21;&#x677F;" class="camera-template-field" />
            <ui:Button name="apply-camera-preview-button" text="&#x5E94;&#x7528;&#x9884;&#x89C8;" tooltip="&#x5728; 16:9 Game View &#x9884;&#x89C8;&#x5F53;&#x524D;&#x623F;&#x95F4;" />
            <ui:Button name="stop-camera-preview-button" text="&#x5173;&#x95ED;&#x9884;&#x89C8;" tooltip="&#x79FB;&#x9664;&#x4E34;&#x65F6;&#x955C;&#x5934;&#x5E76;&#x6062;&#x590D; Game View &#x753B;&#x5E45;" />
            <ui:Label name="camera-preview-state-label" text="&#x672A;&#x542F;&#x7528;" class="camera-preview-state" />
        </ui:VisualElement>
        <ui:VisualElement class="cover-position-toolbar">
            <ui:Label text="&#x89D2;&#x8272;&#x63A9;&#x4F53;" class="toolbar-label" />
            <uie:Vector3Field name="cover-position-field" label="&#x5C40;&#x90E8;&#x4F4D;&#x7F6E;" class="cover-position-field" tooltip="X &#x63A7;&#x5236;&#x6A2A;&#x5411;&#xFF0C;Y &#x63A7;&#x5236;&#x9AD8;&#x5EA6;&#xFF0C;Z &#x63A7;&#x5236;&#x753B;&#x9762;&#x6DF1;&#x5EA6;&#x3002;&#x5F53;&#x524D;&#x955C;&#x5934;&#x5728;&#x8D1F; Z &#x65B9;&#x5411;&#xFF0C;&#x589E;&#x5927; Z &#x53EF;&#x907F;&#x514D;&#x63A9;&#x4F53;&#x906E;&#x6321;&#x89D2;&#x8272;&#x3002;" />
            <ui:Button name="reset-cover-position-button" text="&#x91CD;&#x7F6E;" tooltip="&#x6062;&#x590D;&#x9ED8;&#x8BA4;&#x63A9;&#x4F53;&#x4F4D;&#x7F6E;" />
        </ui:VisualElement>

        <ui:VisualElement class="content-split">
            <ui:VisualElement class="browser-pane">
                <ui:Label text="房间库" class="section-title" />
                <uie:ToolbarSearchField name="search-field" class="search-field" />
                <ui:DropdownField name="group-filter" label="主分组" />
                <ui:DropdownField name="tag-filter" label="标签" />
                <ui:DropdownField name="status-filter" label="校验" />
                <ui:ListView name="room-list" class="room-list" selection-type="Single" virtualization-method="DynamicHeight" />
                <ui:Label name="room-count-label" text="0 个房间" class="muted-label" />
            </ui:VisualElement>

            <ui:VisualElement class="main-pane">
                <ui:VisualElement class="marker-toolbar">
                    <ui:Label text="放置工具" class="toolbar-label" />
                    <ui:Button name="place-exit-button" text="出口" tooltip="在 SceneView 放置出口插槽" class="marker-tool marker-tool--exit" />
                    <ui:Button name="place-player-button" text="玩家" tooltip="在 SceneView 放置玩家入口" class="marker-tool marker-tool--player" />
                    <ui:Button name="place-enemy-button" text="敌人" tooltip="在 SceneView 放置敌人出生点" class="marker-tool marker-tool--enemy" />
                    <ui:Button name="place-destructible-button" text="可破坏物" tooltip="在 SceneView 放置可破坏物插槽" class="marker-tool marker-tool--destructible" />
                    <ui:Button name="place-reachable-button" text="可到达点" tooltip="在 SceneView 放置可到达点" class="marker-tool marker-tool--reachable" />
                    <ui:VisualElement class="toolbar-spacer" />
                    <ui:FloatField name="snap-field" label="吸附" value="0.5" class="snap-field" />
                </ui:VisualElement>

                <ui:VisualElement class="visibility-toolbar">
                    <ui:Label text="显示" class="toolbar-label" />
                    <ui:Toggle name="show-exit-toggle" label="出口" value="true" />
                    <ui:Toggle name="show-player-toggle" label="玩家" value="true" />
                    <ui:Toggle name="show-enemy-toggle" label="敌人" value="true" />
                    <ui:Toggle name="show-destructible-toggle" label="可破坏物" value="true" />
                    <ui:Toggle name="show-reachable-toggle" label="可到达点" value="true" />
                </ui:VisualElement>

                <ui:VisualElement class="authoring-split">
                    <ui:ScrollView name="room-details-scroll" class="details-pane">
                        <ui:Label text="房间资料" class="section-title" />
                        <ui:VisualElement name="room-details" />
                    </ui:ScrollView>

                    <ui:VisualElement class="marker-pane">
                        <ui:Label text="玩法标记" class="section-title" />
                        <ui:ListView name="marker-list" class="marker-list" selection-type="Single" virtualization-method="DynamicHeight" />
                        <ui:VisualElement class="marker-actions">
                            <ui:Button name="duplicate-marker-button" text="复制标记" />
                            <ui:Button name="delete-marker-button" text="删除标记" class="danger-button" />
                        </ui:VisualElement>
                        <ui:ScrollView name="marker-details-scroll" class="marker-details-scroll">
                            <ui:Label text="所选标记" class="subsection-title" />
                            <ui:VisualElement name="marker-details" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="validation-pane">
                    <ui:VisualElement class="validation-header">
                        <ui:Label text="结构校验" class="section-title" />
                        <ui:Label name="validation-summary-label" class="validation-summary" />
                    </ui:VisualElement>
                    <ui:ListView name="validation-list" class="validation-list" selection-type="Single" virtualization-method="DynamicHeight" />
                </ui:VisualElement>

                <ui:Label name="status-label" text="请选择房间" class="status-bar" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
