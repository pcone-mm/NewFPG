          \u53EA\u4FDD\u5B58\u6280\u80FD\u3001\u673A\u5236\u3001\u79FB\u52A8\u6570\u503C\u548C
          BattleArenaZoneMap \u533A\u57DF\u7EC4\u3002\u9C7C\u602A\u4F7F\u7528
          BT_Fish\uFF1A\u627E Player\uFF0C\u6280\u80FD\u53EF\u7528\u65F6\u79FB\u52A8\u5230
          near/mid \u533A\u57DF\u7EC4\uFF0C\u786E\u8BA4\u8DDD\u79BB\u548C\u89C6\u7EBF\u540E\u91CA\u653E\u8FD1\u8EAB\u54AC\u51FB\uFF0C\u7ED3\u675F\u540E\u5C1D\u8BD5\u9000\u5230
          far \u533A\u57DF\u7EC4\uFF1B\u4E0D\u53EF\u7528\u65F6\u8FFD\u8E2A\u76EE\u6807\uFF0C\u65E0\u76EE\u6807\u65F6\u5DE1\u903B\u3002"
