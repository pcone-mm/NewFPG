        designerNote: "\u9C7C\u602A\u57FA\u7840\u653B\u51FB\uFF1A\u5F00\u59CB\u65BD\u653E\u540E\u505C\u6B62\u79FB\u52A8\u5E76\u663E\u793A\u9884\u8B66\uFF0C\u7B49\u5F85
