  catalog:
    version: draft-2026-06-30
    source: "Unity ScriptableObject \u602A\u7269\u914D\u7F6E"
    designerNote: "\u8FD0\u884C\u65F6\u9ED8\u8BA4\u4ECE monster_catalog.json \u8BFB\u53D6\uFF1B\u7B56\u5212\u53EF\u5728
      MonsterCatalogAuthoring.asset \u91CC\u7F16\u8F91\u540E\u5BFC\u51FA JSON\u3002ID\u3001Tag\u3001Animator
      \u53C2\u6570\u3001Layer \u540D\u3001\u8D44\u6E90\u8DEF\u5F84\u662F\u8FD0\u884C\u65F6\u7ED1\u5B9A\u952E\uFF0C\u4E0D\u8981\u4E3A\u4E86\u4E2D\u6587\u663E\u793A\u6539\u540D\u3002\u602A\u7269
      AI \u6D41\u7A0B\u5728 Behavior Designer \u884C\u4E3A\u6811\u4E2D\u914D\u7F6E\uFF0C\u672C\u8868\u53EA\u4FDD\u5B58\u6570\u503C\u3001\u6280\u80FD\u3001\u673A\u5236\u548C\u7AD9\u4F4D\u533A\u57DF\u7EC4\u6570\u636E\u3002"
    monsters:
    - monsterId: fish
      displayName: "\u9C7C\u602A"
      designerNote: "\u9C7C\u602A\u914D\u7F6E\uFF1AFish.prefab \u4FDD\u7559
        MonsterConfigBinding\u3001BehaviorTree\u3001monsterId \u548C catalogJson \u5F15\u7528\uFF1B\u79FB\u52A8\u3001\u6280\u80FD\u3001\u673A\u5236\u548C\u6218\u6597\u533A\u57DF\u7EC4\u4ECE\u672C
        catalog \u8BFB\u53D6\u3002monsterId \u662F\u8FD0\u884C\u65F6\u67E5\u627E\u952E\uFF0C\u4FDD\u6301
        fish\u3002"
      prefabPath: Assets/Prefabs/Monster/Fish.prefab
      movement:
        designerNote: "\u63A7\u5236 A* AIPath \u79FB\u52A8\u3001\u8FFD\u51FB\u3001\u5DE1\u903B\u3001BattleArenaZoneMap
          \u533A\u57DF\u7EC4\u7AD9\u4F4D\u91C7\u6837\u3001\u78B0\u649E\u4F53\u81EA\u52A8\u9002\u914D\u548C\u79FB\u52A8\u52A8\u753B\u53C2\u6570\u3002targetTag\u3001MoveX\u3001MoveZ\u3001Speed\u3001IsMoving\u3001MovementState
          \u6218\u6597 AI \u627E Player \u9ED8\u8BA4\u4E0D\u9650\u5236\u8DDD\u79BB\uFF0C\u907F\u514D\u9C7C\u602A\u8FDC\u79BB\u73A9\u5BB6\u540E\u4E22\u76EE\u6807\u5E76\u8BEF\u8FDB\u5DE1\u903B\u3002targetTag\u3001MoveX\u3001MoveZ\u3001Speed\u3001IsMoving\u3001MovementState
          \u5FC5\u987B\u548C Unity Tag/Animator \u53C2\u6570\u4E00\u81F4\uFF1Bnear/mid/far/left/center/right
          \u662F\u7A33\u5B9A\u533A\u57DF\u7EC4 ID\uFF0C\u4E0D\u8981\u7FFB\u8BD1\u3002"
